#!/usr/bin/bash
# Put the runner image in the container storage: from the OS image (offline variant) or by pulling it.
set -euo pipefail

ref="$(sed -n 's/^Image=//p' '/usr/share/containers/systemd/github-runner@.container')"
tag="${ref##*:}"
repo="${ref%:*}"

if podman image exists "$ref"; then
    echo "$ref is already loaded"
elif [[ -d /usr/share/github-runner/runner-image ]]; then
    echo "Loading $ref from the OS image"
    skopeo copy "oci:/usr/share/github-runner/runner-image:${tag}" "containers-storage:${ref}"
else
    echo "Pulling $ref"
    podman pull --retry 3 "$ref"
fi

# drop runner images of earlier OS versions
podman images --format '{{.Repository}}:{{.Tag}}' | { grep -F "${repo}:" || true; } | { grep -vxF "$ref" || true; } | xargs -r podman rmi
