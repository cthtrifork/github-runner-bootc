#!/usr/bin/bash
# ExecStartPre of github-runner@<instance>: trade the GitHub App key for a one-hour installation token, ask GitHub for a
# single-use JIT runner configuration and write it where the container reads it. No secret ever lives in the image.
#
# /etc/github-runner/ (root only, written by github-runner-seed-app):
#   app-id, installation-id, private-key.pem
#   config: SCOPE=repo:<owner>/<repo> or org:<org>, LABELS=a,b,c, RUNNER_GROUP_ID=1, MIN_FREE_GB=10, API_URL=https://api.github.com
set -euo pipefail

inst="${1:?Usage: $0 <instance>}"
dir=/etc/github-runner
drain=/run/github-runner/draining

if [[ -e "$drain" ]]; then
    echo "Host is draining for an update; not registering a new runner" >&2
    exit 1
fi

# shellcheck disable=SC1091
set -a; . "$dir/config"; set +a
: "${SCOPE:?SCOPE missing in $dir/config}"
API_URL="${API_URL:-https://api.github.com}"
RUNNER_GROUP_ID="${RUNNER_GROUP_ID:-1}"
LABELS="${LABELS:-self-hosted,Linux,X64,bootc}"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

app_id="$(tr -d '[:space:]' <"$dir/app-id")"
installation_id="$(tr -d '[:space:]' <"$dir/installation-id")"
now="$(date +%s)"
header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)"
signature="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$dir/private-key.pem" | b64url)"

gh_api() { # <method> <path> [json body]
    curl -fsS --max-time 30 -X "$1" \
        -H "Authorization: Bearer ${AUTH}" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        ${3:+-d "$3"} "${API_URL}$2"
}

AUTH="$header.$payload.$signature"
token="$(gh_api POST "/app/installations/${installation_id}/access_tokens" | jq -er .token)"
AUTH="$token"

case "$SCOPE" in
repo:*/*) path="/repos/${SCOPE#repo:}/actions/runners/generate-jitconfig" ;;
org:*) path="/orgs/${SCOPE#org:}/actions/runners/generate-jitconfig" ;;
*) echo "SCOPE must be repo:<owner>/<repo> or org:<org>" >&2; exit 1 ;;
esac

name="$(hostname -s)-${inst}-$(openssl rand -hex 3)"
body="$(jq -cn --arg name "$name" --argjson group "$RUNNER_GROUP_ID" --arg labels "$LABELS" \
    '{name: $name, runner_group_id: $group, labels: ($labels | split(",")), work_folder: "_work"}')"
jit="$(gh_api POST "$path" "$body" | jq -er .encoded_jit_config)"

install -d -m 0700 /run/github-runner
tmp="$(mktemp /run/github-runner/.env.XXXXXX)"
trap 'rm -f "$tmp"' EXIT
printf 'ACTIONS_RUNNER_INPUT_JITCONFIG=%s\n' "$jit" >"$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "/run/github-runner/${inst}.env"
trap - EXIT
echo "JIT runner configuration minted for $name"
