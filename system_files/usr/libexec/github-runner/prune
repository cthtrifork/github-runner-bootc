#!/usr/bin/bash
# Remove old data from the per-instance storage of runners that are not running.
set -uo pipefail

for dir in /var/lib/github-runner/[0-9]*; do
    [[ -d "$dir" ]] || continue
    inst="${dir##*/}"
    if systemctl is-active --quiet "github-runner@${inst}.service"; then
        echo "Skipping $inst: running"
        continue
    fi
    echo "Pruning $dir"
    find "$dir/containers" "$dir/rootless" -mindepth 1 -maxdepth 1 -mtime +7 -exec rm -rf {} + 2>/dev/null || true
    rm -rf "${dir:?}/var-tmp" "${dir:?}/work"
done
