[Unit]
Description=Load or pull the runner image into the container storage
Documentation=https://github.com/cthtrifork/github-runner-bootc
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/containers
# the pull needs the registry: keep trying
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/github-runner/load-image
TimeoutStartSec=30min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
