[Unit]
Description=Stage an OS update and reboot once the runners are idle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/github-runner/update-and-drain
# The drain waits for running jobs, so allow it as long as the script's own timeout (6 hours) plus margin.
TimeoutStartSec=7h
