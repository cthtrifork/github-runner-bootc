{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices'
  ],
  labels: [
    'dependencies',
    'automated-pr',
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Dependency Dashboard',
  dependencyDashboardLabels: ['dependencies'],
  // New releases wait 2 days before a branch or PR exists.
  minimumReleaseAge: '2 days',
  // quay.io and ghcr.io images have no release timestamp: count them as old enough.
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  internalChecksFilter: 'strict',
  // commits go through GitHub's API as the App, so they are verified
  platformCommit: 'enabled',
  osvVulnerabilityAlerts: true,

  prHourlyLimit: 5,
  prConcurrentLimit: 10,
  // no `schedule`: the cron in renovate.yaml is the only timing
  vulnerabilityAlerts: {
    addLabels: [
      'vulnerability',
    ],
    additionalBranchPrefix: '',
  },
  major: {
    automerge: false,
  },
  minor: {
    automerge: false,
  },
  patch: {
    automerge: true,
  },
  // Renovate merges the PR itself once the checks pass
  automergeType: 'pr',
  platformAutomerge: false,
  ignoreTests: false,
  rebaseWhen: 'auto',
  // a later rule wins
  packageRules: [
    {
      matchUpdateTypes: ['digest', 'pin', 'pinDigest'],
      automerge: true,
    },
    {
      // The runner image tag is in github-runner.containerfile and in the Quadlet unit; bump both in one PR.
      matchPackageNames: ['ghcr.io/cthtrifork/talos-gitops/github-actions-runner'],
      pinDigests: false,
      groupName: 'runner image',
    },
    {
      // the Fedora base image: updates wait for approval on the Dependency Dashboard
      matchPackageNames: ['quay.io/fedora/fedora-bootc'],
      dependencyDashboardApproval: true,
    },
    {
      // patches stay out of the groups so a minor does not hold them back
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor'],
      groupName: 'actions',
    },
    {
      matchManagers: ['custom.regex'],
      matchUpdateTypes: ['minor'],
      groupName: 'tools',
      automerge: true,
    },
    {
      "extends": [
        "helpers:pinGitHubActionDigests"
      ],
      "extractVersion": "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$",
      "recreateWhen": "always",
    },
    {
      // Renovate itself automerges every update type
      matchPackageNames: ['renovate', 'renovatebot/github-action'],
      automerge: true,
      groupName: null,
    },
  ],
  customManagers: [
    {
      // container images outside a Dockerfile
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
        '/^\\.github/actions/[^/]+/action\\.ya?ml$/',
      ],
      matchStrings: [
        '(?<depName>ghcr\\.io/hhd-dev/rechunk):(?<currentValue>v?\\d[\\w.-]*)',
        '(?<depName>quay\\.io/coreos/chunkah):(?<currentValue>v?\\d[\\w.-]*)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // the runner image in the Quadlet unit: Renovate bumps it together with the containerfile (packageRules, 'runner image')
      customType: 'regex',
      managerFilePatterns: [
        '/^system_files/.+/github-runner@\\.container$/',
      ],
      matchStrings: [
        '^Image=(?<depName>[^:\\s]+):(?<currentValue>v?\\d[\\w.-]*)\\s*$',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // versions marked with a `# renovate: datasource=<ds> depName=<name>` comment
      customType: 'regex',
      managerFilePatterns: [
        '/^[^/]+\\.containerfile$/',
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
        '/^\\.github/actions/[^/]+/action\\.ya?ml$/',
      ],
      matchStrings: [
        '\\S+\\s*[:=]\\s*[\'"]?(?<currentValue>[^\\s\'"]+)[\'"]?\\s+# renovate:\\s*datasource=(?<datasource>\\S+)\\s+(?:depName|packageName)=(?<depName>\\S+)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/.*\\.sh$/',
      ],
      matchStrings: [
        '(?<depName>[^\\s"\']+)="?(?<currentValue>.[^"\'\\s]*)"?\\s+# renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<packageName>[^\\s]+)',
      ],
      datasourceTemplate: '{{{datasource}}}',
      packageNameTemplate: '{{{packageName}}}',
      versioningTemplate: 'semver',
    },
  ],
}
